{
  "name": "vici-desktop",
  "productName": "Vici",
  "version": "2026.920.0",
  "private": true,
  "description": "Vici — музыкальный плеер для Navidrome",
  "author": "Aut0iq",
  "homepage": "https://github.com/Aut0iq/Vici",
  "desktopName": "vici.desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "publish": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.aut0iq.vici",
    "productName": "Vici",
    "copyright": "Aut0iq",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "icon.png",
      "web/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Vici",
      "artifactName": "Vici-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "executableName": "vici",
      "maintainer": "Aut0iq <Aut0iq@users.noreply.github.com>",
      "artifactName": "Vici-${version}.${ext}",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "Aut0iq",
      "repo": "Vici"
    }
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
